# Copy: cp .env.example .env   (.env đã nằm trong .gitignore, KHÔNG commit)
# Không ghi secret thật vào file này.

PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Đổi thành chuỗi ngẫu nhiên dài, ví dụ: python -c "import secrets;print(secrets.token_urlsafe(32))"
AGENT_API_KEY=change-me

# Khi chạy bằng docker compose, REDIS_URL được compose ghi đè thành redis://redis:6379/0
REDIS_URL=redis://localhost:6379/0

RATE_LIMIT_PER_MINUTE=10
DAILY_BUDGET_USD=1.0
